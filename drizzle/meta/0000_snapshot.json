        "prompts_id_format": {
          "name": "prompts_id_format",
          "value": "length(id) = 8 AND id GLOB '[0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9][A-Za-z0-9]'"
        },
        "prompts_category_matches_id": {
          "name": "prompts_category_matches_id",
          "value": "\"prompts\".\"category\" = cast(substr(\"prompts\".\"id\", 1, 1) AS integer)"
        },
        "prompts_author_score_range": {
          "name": "prompts_author_score_range",
          "value": "\"prompts\".\"author_score\" BETWEEN 0 AND 16"
        },
        "prompts_answer_count": {
          "name": "prompts_answer_count",
          "value": "json_type(\"prompts\".\"answers\") = 'array' AND json_array_length(\"prompts\".\"answers\") BETWEEN 5 AND 25"
